{
  "name": "tiktok-ai-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "TikTok AI Publisher — إدارة ونشر محتوى TikTok بأوامر عربية عبر Content Posting API الرسمية",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/main.ts",
    "start:api": "tsx src/api/main.ts",
    "start:worker": "tsx src/worker/main.ts",
    "start:mcp": "tsx src/mcp/main.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.5.3",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
