# ========= أساسي =========
NODE_ENV=development
PORT=4000
# عنوان لوحة الويب العام (لروابط الموافقة وإعادة التوجيه)
PUBLIC_WEB_URL=http://localhost:3000
# عنوان الـAPI العام (يُستخدم في redirect_uri وروابط الصور لـPULL_FROM_URL). يجب HTTPS في الإنتاج
PUBLIC_API_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiktok_publisher
REDIS_URL=redis://localhost:6379

# ========= الأمان (ولّدها بنفسك؛ لا تستخدم قيماً افتراضية) =========
# 32 بايت base64:  openssl rand -base64 32
TOKEN_ENC_KEY=
# سر توقيع الجلسات وروابط الوسائط:  openssl rand -base64 48
SESSION_SECRET=
# كلمة مرور المالك لدخول اللوحة: ولّد التجزئة بالأمر  npm run cli -- hash-password
OWNER_PASSWORD_HASH=

# ========= TikTok (من لوحة TikTok for Developers — انظر docs/TIKTOK_SETUP.md) =========
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# يجب أن يطابق حرفياً عنوان Redirect URI المسجَّل في تطبيقك
TIKTOK_REDIRECT_URI=http://localhost:4000/auth/tiktok/callback
# video.upload فقط يكفي للمسودات؛ أضف video.publish للنشر المباشر (يتطلب موافقة TikTok)
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# ========= التخزين =========
# local (للتطوير) أو s3 (أي خدمة متوافقة: S3/R2/MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ========= الذكاء الاصطناعي (اختياري: لتوليد الوصف والهاشتاقات وتحليل الصور) =========
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ========= MCP =========
# رمز API لخادم MCP (يُنشأ بالأمر  npm run cli -- create-token mcp publish:prepare ...)
MCP_API_URL=http://localhost:4000
MCP_API_TOKEN=

# ========= إضافات =========
# تنبيهات الفشل: POST نصي إلى هذا الرابط (متوافق مع ntfy.sh). اختياري؛ التنبيهات تُسجَّل دائماً في سجل التدقيق
NOTIFY_WEBHOOK_URL=
# المجلد الوحيد الذي يستطيع أمر upload_media رفع ملفات منه (حماية من حقن أوامر). مطلوب لرفع الملفات من Claude Code
MCP_ALLOWED_DIR=
# تفعيل أداة approve_tiktok_post (موافقة من المحادثة). الأفضل تركه false وإبقاء الموافقة على هاتفك
MCP_ENABLE_APPROVAL=false
# للاختبارات
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiktok_publisher_test
TEST_REDIS_URL=redis://localhost:6379
